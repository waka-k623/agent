# Runtime safety
APP_ENV=demo
DEMO_MODE_DEFAULT=true
ALLOW_LIVE_WRITES=false

# Select: openai / anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google OAuth local files
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_TOKEN_PATH=calendar_token.json
GOOGLE_SHEETS_TOKEN_PATH=sheets_token.json
GOOGLE_CONTACTS_TOKEN_PATH=contacts_token.json
GOOGLE_GMAIL_ACTION_TOKEN_PATH=gmail_action_token.json
GOOGLE_CALENDAR_ACTION_TOKEN_PATH=calendar_action_token.json

# Google Sheets CRM
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads

# Demo login bootstrap
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_USER_PASSWORD=change-me-user

# Future MCP connector
MCP_SERVER_URL=
